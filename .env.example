# Sanjivani AI - Sugar Factory MCP Server & HTTP API Bridge Configuration
# Note: Keep all real credentials in your local .env file. Never commit secrets.

# Backend HTTP API Bridge Port
PORT=5000

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=sanjivani_sugar
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
